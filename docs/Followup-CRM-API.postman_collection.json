        },
        {
          "name": "Export CSV (selected IDs)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/business-finder/export/csv?ids[]={{business_lead_id}}", "host": ["{{base_url}}"], "path": ["business-finder", "export", "csv"], "query": [{ "key": "ids[]", "value": "{{business_lead_id}}", "description": "Repeat ids[] for more records" }] } }
        },
        {
          "name": "Export PDF (filtered)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/business-finder/export/pdf?category=Hospitals&city=Chennai&contact=phone_available", "host": ["{{base_url}}"], "path": ["business-finder", "export", "pdf"], "query": [{ "key": "category", "value": "Hospitals" }, { "key": "city", "value": "Chennai" }, { "key": "contact", "value": "phone_available" }] }, "description": "All list filters work here too." }
        }
